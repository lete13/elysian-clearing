# Copy this to .env for local development.
# On Railway, set the same keys in the service → Variables tab.
# DATABASE_URL is injected automatically when you add the PostgreSQL plugin.

# ── Core ──────────────────────────────────────────────────────────────────────
# Hosthub API key (Settings → API Keys). When set, users skip pasting a key.
HOSTHUB_API_KEY=your_hosthub_key_here

# Shared gate password. With USERS_JSON set, the live app uses session cookies
# (/login) instead of plain HTTP Basic Auth — APP_PASSWORD still gates anonymous access.
APP_PASSWORD=your_team_password

# Optional multi-user roles JSON, e.g.
# [{"user":"lef","pass":"…","role":"admin"},{"user":"ops","pass":"…","role":"ops"}]
# USERS_JSON=

# Optional; defaults to a derived secret. Set explicitly in production.
# SESSION_SECRET=

# PostgreSQL (Railway sets DATABASE_URL). Local example:
DATABASE_URL=postgresql://user:pass@localhost:5432/elysian

PORT=3000

# ── Email (owner reports, lead welcome) ───────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# EMAIL_REPLY_TO=
# EMAIL_BCC=

# ── Viva (Payments Check + Cash Flow) ─────────────────────────────────────────
# Account Transactions Credentials: Settings → API Access
VIVA_TX_USER=your_viva_tx_username
VIVA_TX_PASS=your_viva_tx_password
# live (default) or demo
VIVA_ENV=live
# Optional: Cash Flow lookback days (30–1200, default 730)
# VIVA_CASHFLOW_DAYS=730
# Optional: comma-separated IBANs treated as internal transfers (not expense)
# VIVA_INTERNAL_IBANS=

# ── Oxygen (Greek e-invoicing / Monthly Close) ────────────────────────────────
# OXYGEN_API_KEY=
# OXYGEN_API_BASE=https://api.oxygen.gr
# OXYGEN_TAX24_ID=
# OXYGEN_PM_ID=
# OXYGEN_SEQ_S=
# OXYGEN_SEQ_RS=

# ── Daily Ops AI schedule check ───────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# SCHEDULE_CHECK_MODEL=claude-sonnet-4-20250514

# ── Meta lead ads (Leads tab) ─────────────────────────────────────────────────
# META_PAGE_TOKEN=
# META_API_VERSION=v25.0

# ── Platform Invoices (Airbnb / Booking.com Playwright pull) ──────────────────
# AIRBNB_HOST_EMAIL=
# AIRBNB_HOST_PASSWORD=
# BOOKING_HOST_EMAIL=
# BOOKING_HOST_PASSWORD=
# Prefer saved Playwright storageState (see scripts/platform-invoice-save-session.js):
# AIRBNB_STORAGE_STATE_B64=
# BOOKING_STORAGE_STATE_B64=
# PLAYWRIGHT_PROXY_SERVER=
# PLATFORM_INVOICE_ACCOUNTANT_EMAIL=
# Optional one-shot OTP when headed login hits email code:
# AIRBNB_OTP=

# ── Ops / debug ───────────────────────────────────────────────────────────────
# AUTO_SYNC_HOUR=6
# SRVBOOT_DRYRUN=1
