   "replace": "\n</script>\n\n<!-- LEADS TAB -->\n<style>\n/* Leads tab.\n   Scoped under #tab-leads exactly like the Monthly Close block is scoped under\n   #tab-mt. Note --acc is never defined in :root, so the gold is written out. */\n#tab-leads .ld-wrap{padding:18px 22px;max-width:1480px;margin:0 auto}\n#tab-leads .ld-head{background:var(--bg2);border:1px solid var(--bdr);border-radius:var(--r);padding:14px;margin-bottom:12px}\n#tab-leads .ld-top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}\n#tab-leads .ld-brand{font-weight:700;font-size:15px;letter-spacing:.2px}\n#tab-leads .ld-sub{font-size:11px;color:var(--tx3);margin-top:2px}\n#tab-leads .ld-meta{border:1px solid var(--bdr);border-radius:20px;padding:4px 11px;font-size:11.5px;white-space:nowrap;background:var(--bg)}\n#tab-leads .ld-meta.off{border-color:#D9770655;color:#D97706}\n#tab-leads .ld-meta.on{border-color:#05966955;color:#059669}\n#tab-leads .ld-load{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}\n#tab-leads .ld-chip{background:var(--bg);border:1px solid var(--bdr);border-radius:var(--r);padding:6px 10px;min-width:92px}\n#tab-leads .ld-chip.away{opacity:.5}\n#tab-leads .ld-chip.next{border-color:#C9A84C;box-shadow:0 0 0 2px #C9A84C22}\n#tab-leads .ld-chip .cl{display:block;font-size:10px;color:var(--tx3);text-transform:uppercase;letter-spacing:.4px}\n#tab-leads .ld-chip .cn{font-size:15px;font-weight:700}\n#tab-leads .ld-chip .cs{font-size:10px;color:var(--tx3)}\n#tab-leads .ld-controls{display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}\n#tab-leads .ld-tabs{display:flex;gap:4px}\n#tab-leads .ldtab{background:var(--bg2);border:1px solid var(--bdr);color:var(--tx3);border-radius:var(--r);padding:7px 13px;font-size:12px;cursor:pointer}\n#tab-leads .ldtab.on{background:#C9A84C;border-color:#C9A84C;color:#fff;font-weight:600}\n#tab-leads .ld-search{background:var(--bg);border:1px solid var(--bdr);color:var(--tx);border-radius:var(--r);padding:7px 10px;font-size:12px;min-width:200px;flex:1;max-width:340px}\n#tab-leads .ld-spacer{flex:1}\n#tab-leads .ld-board{display:flex;gap:10px;overflow-x:auto;padding-bottom:8px;align-items:flex-start}\n#tab-leads .ld-col{background:var(--bg2);border:1px solid var(--bdr);border-radius:var(--r);padding:9px;min-width:212px;width:212px;flex:0 0 auto}\n#tab-leads .ld-colh{display:flex;align-items:baseline;justify-content:space-between;gap:6px;margin-bottom:8px}\n#tab-leads .ld-colt{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px}\n#tab-leads .ld-coln{font-size:11px;color:var(--tx3)}\n#tab-leads .ld-card{background:var(--bg);border:1px solid var(--bdr);border-left:3px solid var(--bdr);border-radius:var(--r);padding:9px 10px;margin-bottom:6px;cursor:pointer;text-align:left;width:100%;color:var(--tx);display:block}\n#tab-leads .ld-card:hover{border-color:var(--bdr2)}\n#tab-leads .ld-card.late{border-left-color:#DC2626}\n#tab-leads .ld-card.soon{border-left-color:#D97706}\n#tab-leads .ld-name{font-size:12.5px;font-weight:600;margin-bottom:2px}\n#tab-leads .ld-where{font-size:11px;color:var(--tx2);margin-bottom:3px}\n#tab-leads .ld-foot{display:flex;align-items:center;justify-content:space-between;gap:6px;font-size:10.5px;color:var(--tx3)}\n#tab-leads .ld-own{background:var(--bg2);border-radius:99px;padding:1px 7px;font-size:10px}\n#tab-leads .ld-empty{padding:22px;text-align:center;color:var(--tx3);font-size:12px}\n#tab-leads .ld-lrow{display:flex;align-items:center;gap:10px;background:var(--bg2);border:1px solid var(--bdr);border-radius:var(--r);padding:9px 11px;margin-bottom:4px;cursor:pointer;text-align:left;width:100%;color:var(--tx)}\n#tab-leads .ld-lrow:hover{border-color:var(--bdr2)}\n#tab-leads .ld-stage{border:1px solid var(--bdr);border-radius:99px;padding:2px 9px;font-size:10px;font-weight:600;background:var(--bg);white-space:nowrap}\n#tab-leads .ld-lname{font-size:12.5px;font-weight:600;min-width:130px}\n#tab-leads .ld-lsub{font-size:11.5px;color:var(--tx2);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n#tab-leads .ld-lago{font-size:10.5px;color:var(--tx3);min-width:44px;text-align:right}\n/* Ticket sheet */\n#tab-leads .ld-sheetbg{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:900;display:flex;align-items:flex-start;justify-content:center;padding:24px;overflow-y:auto;overflow-x:hidden}\n#tab-leads .ld-sheet{background:var(--bg);border-radius:var(--rl);width:100%;max-width:760px;box-shadow:0 20px 50px rgba(0,0,0,.3)}\n#tab-leads .ld-sh{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 18px;border-bottom:1px solid var(--bdr);position:sticky;top:0;background:var(--bg);border-radius:var(--rl) var(--rl) 0 0;z-index:2}\n#tab-leads .ld-sht{font-size:18px;font-weight:700}\n#tab-leads .ld-shs{font-size:11px;color:var(--tx3);margin-top:3px}\n#tab-leads .ld-x{background:none;border:0;color:var(--tx3);cursor:pointer;font-size:24px;line-height:1;padding:0 4px}\n#tab-leads .ld-x:hover{color:#DC2626}\n#tab-leads .ld-body{padding:16px 18px}\n#tab-leads .ld-sec{border-top:1px solid var(--bdr);padding-top:13px;margin-top:13px}\n#tab-leads .ld-sect{font-size:10px;color:var(--tx3);text-transform:uppercase;letter-spacing:.4px;margin-bottom:7px}\n#tab-leads .ld-contact{display:flex;gap:8px;flex-wrap:wrap}\n#tab-leads .ld-cbtn{display:inline-flex;align-items:center;gap:6px;background:var(--bg2);border:1px solid var(--bdr);border-radius:var(--r);padding:9px 13px;font-size:12.5px;color:var(--tx);text-decoration:none}\n#tab-leads .ld-cbtn:hover{border-color:#C9A84C}\n#tab-leads .ld-kv{display:grid;grid-template-columns:150px 1fr;gap:5px 12px;font-size:12px}\n#tab-leads .ld-k{color:var(--tx3)}\n#tab-leads .ld-v{color:var(--tx);word-break:break-word}\n#tab-leads .ld-steps{display:flex;gap:5px;flex-wrap:wrap}\n#tab-leads .ldpill{border:1px solid var(--bdr);background:var(--bg);color:var(--tx3);border-radius:99px;padding:6px 12px;font-size:11.5px;cursor:pointer}\n#tab-leads .ldpill.done{background:#05966915;border-color:#059669;color:#059669;font-weight:600}\n#tab-leads .ldpill.cur{border-color:#C9A84C;color:var(--tx);font-weight:700;box-shadow:0 0 0 2px #C9A84C33}\n#tab-leads .ld-tl{display:flex;flex-direction:column;gap:0;max-height:260px;overflow-y:auto}\n#tab-leads .ld-ev{display:flex;gap:9px;font-size:11.5px;padding:5px 0;border-bottom:1px dashed var(--bdr)}\n/* A flex item will not shrink below its own content unless told to, so a single\n   long timeline entry used to stretch the sheet past the edge of a phone. */\n#tab-leads .ld-ev>span+span{flex:1;min-width:0;overflow-wrap:anywhere}\n#tab-leads .ld-evw{color:var(--tx3);white-space:nowrap;min-width:92px}\n#tab-leads .ld-danger{display:flex;gap:8px;flex-wrap:wrap;border-top:1px solid var(--bdr);margin-top:13px;padding-top:13px}\n#tab-leads .ld-in{background:var(--bg);border:1px solid var(--bdr);color:var(--tx);border-radius:var(--r);padding:8px 10px;font-size:12.5px;width:100%}\n#tab-leads .ld-form{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n#tab-leads .ld-form .full{grid-column:1/-1}\n#tab-leads .ld-dot{display:inline-block;width:7px;height:7px;border-radius:99px;margin-right:5px}\n@media (max-width:760px){\n  #tab-leads .ld-wrap{padding:12px 10px}\n  #tab-leads .ld-kv{grid-template-columns:1fr;gap:1px 0}\n  #tab-leads .ld-kv .ld-k{margin-top:7px}\n  #tab-leads .ld-form{grid-template-columns:1fr}\n  #tab-leads .ld-sheetbg{padding:0}\n  #tab-leads .ld-sheet{border-radius:0;min-height:100%}\n  #tab-leads .ld-sh{border-radius:0}\n  #tab-leads .ld-search{max-width:none}\n  #tab-leads .ld-col{min-width:82vw;width:82vw}\n  #tab-leads .ld-cbtn{flex:1;min-width:0;justify-content:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n  #tab-leads .ld-ev{flex-wrap:wrap;gap:2px 9px}\n  #tab-leads .ld-evw{min-width:0}\n  #tab-leads .ld-danger{gap:6px}\n  /* A phone cannot hold name + address + stage + owner + age on one line, and a\n     row that will not shrink drags the whole page sideways. Let it stack. */\n  #tab-leads .ld-lrow{flex-wrap:wrap;gap:4px 8px;padding:9px 10px}\n  #tab-leads .ld-lname{min-width:0;flex:1}\n  #tab-leads .ld-lsub{flex:1 0 100%;order:9}\n  #tab-leads .ld-lago{min-width:0}\n}\n</style>\n<script>\n// LEADS — a Meta lead, tracked to a signed apartment.\n//\n// Leads deliberately do NOT live in the S blob: S syncs on every save and is\n// reloaded on every page load, and a lead is personal data with its own\n// retention rules. They live in the `leads` table behind /api/leads and are\n// fetched on demand, so nothing here touches load()/save()/saveToDb().\n(function () {\n  'use strict';\n  var esc = function (s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;'); };\n\n  var STAGES = [\n    { key: 'new',           label: 'New',           hint: 'Just arrived, not yet picked up' },\n    { key: 'to_contact',    label: 'To contact',    hint: 'Assigned, welcome email drafted' },\n    { key: 'contacted',     label: 'Contacted',     hint: 'Call or email out' },\n    { key: 'qualified',     label: 'Qualified',     hint: 'Owner and property details captured' },\n    { key: 'viewing',       label: 'Viewing',       hint: 'Assessment visit booked' },\n    { key: 'proposal',      label: 'Proposal',      hint: 'Fee, terms and projected income sent' },\n    { key: 'contract_sent', label: 'Contract sent', hint: 'Issued for signature' },\n    { key: 'signed',        label: 'Signed',        hint: 'Returned and countersigned' },\n    { key: 'onboarding',    label: 'Onboarding',    hint: 'Photos, listing, Hosthub, channels' },\n    { key: 'live',          label: 'Live',          hint: 'Earning' }\n  ];\n  var CLOSED = [\n    { key: 'lost',    label: 'Lost',    hint: 'Needs a reason' },\n    { key: 'on_hold', label: 'On hold', hint: 'Parked for now' }\n  ];\n  var ALL = STAGES.concat(CLOSED);\n  var LABEL = {}; ALL.forEach(function (s) { LABEL[s.key] = s.label; });\n  var IDX = {}; STAGES.forEach(function (s, i) { IDX[s.key] = i; });\n  // leadEvent() writes {at, type, by, detail} — the type is the verb.\n  var EVW = { created: 'created the lead —', assigned: 'assigned', stage: 'moved', note: 'noted:',\n              edit: 'edited', email: 'emailed —', archived: 'archived —', restored: 'restored the lead',\n              erased: 'erased the personal data' };\n\n  var view = 'board', search = '', openId = null, sheet = null, editProp = false;\n  var rows = [], cfg = { team: [], slaFirstContactHours: 4 }, metaOn = false;\n  var loading = false, loadErr = '', _searchT = null;\n\n  function who() { return localStorage.getItem('elysian_user_name') || 'Team member'; }\n  function panel() { return document.getElementById('tab-leads'); }\n\n  // \"3d\", \"4h\", \"just now\" — a pipeline is read in elapsed time, not in dates.\n  function ago(v) {\n    if (!v) return '—';\n    var t = new Date(v).getTime(); if (!isFinite(t)) return '—';\n    var m = Math.floor((Date.now() - t) / 60000);\n    if (m < 1) return 'just now';\n    if (m < 60) return m + 'm';\n    if (m < 1440) return Math.floor(m / 60) + 'h';\n    var d = Math.floor(m / 1440);\n    return d < 30 ? d + 'd' : Math.floor(d / 30) + 'mo';\n  }\n  // \"just now\" already reads as a time — \"arrived just now ago\" does not.\n  function since(v) { var a = ago(v); return (a === 'just now' || a === '—') ? a : a + ' ago'; }\n  function when(v) {\n    if (!v) return '—';\n    var d = new Date(v); if (isNaN(d)) return '—';\n    return d.toLocaleDateString('el-GR') + ' ' + d.toLocaleTimeString('el-GR', { hour: '2-digit', minute: '2-digit' });\n  }\n  // Hours since arrival against the first-contact SLA, for anything not yet contacted.\n  function slaState(l) {\n    if (l.first_contact_at || IDX[l.stage] === undefined || IDX[l.stage] > IDX.to_contact) return '';\n    var t = new Date(l.created_time || l.updated_at).getTime();\n    if (!isFinite(t)) return '';\n    var h = (Date.now() - t) / 3600000, lim = Number(cfg.slaFirstContactHours || 4);\n    return h > lim ? 'late' : h > lim * 0.6 ? 'soon' : '';\n  }\n  function teamName(k) {\n    var m = (cfg.team || []).filter(function (t) { return t.key === k; })[0];\n    return m ? m.name : (k || '');\n  }\n\n  // A stage change is stored with the raw keys ('to_contact -> contract_sent').\n  // Nobody reads a timeline in snake_case.\n  function evDetail(e) {\n    var d = String(e.detail || '');\n    if (e.type === 'stage') d = d.replace(/[a-z_]+/g, function (k) { return LABEL[k] || k; });\n    return d;\n  }\n\n  // Data\n  function jget(url) { return fetch(url).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, status: r.status, j: j }; }); }); }\n  function jsend(url, method, body) {\n    return fetch(url, { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) })\n      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, status: r.status, j: j }; }, function () { return { ok: r.ok, status: r.status, j: {} }; }); });\n  }\n  function reload(keepSheet) {\n    loading = true; loadErr = ''; render();\n    var v = view === 'archive' ? 'archived' : 'active';\n    return jget('/api/leads?view=' + v + (search ? '&q=' + encodeURIComponent(search) : ''))\n      .then(function (r) {\n        loading = false;\n        if (!r.ok) { loadErr = (r.j && r.j.error) || ('HTTP ' + r.status); rows = []; }\n        else { rows = r.j.leads || []; cfg = r.j.config || cfg; metaOn = !!r.j.metaConfigured; }\n        render(); if (keepSheet && openId) openTicket(openId, true);\n      })\n      .catch(function (e) { loading = false; loadErr = e.message; render(); });\n  }\n\n  // Rendering\n  function loadStrip() {\n    var open = {};\n    (cfg.team || []).forEach(function (t) { open[t.key] = 0; });\n    rows.forEach(function (l) {\n      if (l.archived_at || l.status === 'won' || l.status === 'lost' || l.status === 'erased') return;\n      if (l.owner && open[l.owner] !== undefined) open[l.owner]++;\n    });\n    // The next lead goes to the lightest available load — show which, so the\n    // assignment rule is visible rather than mysterious.\n    var avail = (cfg.team || []).filter(function (t) {\n      return t.active && !(t.awayUntil && new Date(t.awayUntil) > new Date());\n    });\n    var nextKey = '';\n    avail.forEach(function (t) {\n      var w = Number(t.weight || 1) || 1;\n      if (!nextKey || open[t.key] / w < open[nextKey] / (Number((cfg.team.filter(function (x) { return x.key === nextKey; })[0] || {}).weight || 1) || 1)) nextKey = t.key;\n    });\n    return '<div class=\"ld-load\">' + (cfg.team || []).map(function (t) {\n      var away = t.awayUntil && new Date(t.awayUntil) > new Date();\n      var cls = 'ld-chip' + (!t.active || away ? ' away' : '') + (t.key === nextKey ? ' next' : '');\n      return '<div class=\"' + cls + '\"><span class=\"cl\">' + esc(t.name) + '</span>' +\n        '<span class=\"cn\">' + (open[t.key] || 0) + '</span>' +\n        '<span class=\"cs\">' + (away ? 'away' : !t.active ? 'paused' : t.key === nextKey ? 'next up' : 'open') + '</span></div>';\n    }).join('') + '</div>';\n  }\n\n  function cardHtml(l) {\n    var where = l.property_address || '';\n    var bits = [];\n    if (l.property_size) bits.push(l.property_size);\n    if (l.bedrooms_n != null) bits.push(l.bedrooms_n + ' bed');\n    if (l.bathrooms_n != null) bits.push(l.bathrooms_n + ' bath');\n    return '<button class=\"ld-card ' + slaState(l) + '\" onclick=\"ldOpen(' + l.id + ')\">' +\n      '<div class=\"ld-name\">' + esc(l.full_name || '(no name)') + '</div>' +\n      (where ? '<div class=\"ld-where\">📍 ' + esc(where) + '</div>' : '') +\n      (bits.length ? '<div class=\"ld-where\">' + esc(bits.join(' · ')) + '</div>' : '') +\n      '<div class=\"ld-foot\"><span class=\"ld-own\">' + esc(l.owner ? teamName(l.owner) : 'unassigned') + '</span>' +\n      '<span>' + ago(l.created_time || l.updated_at) + '</span></div></button>';\n  }\n\n  function boardHtml() {\n    var byStage = {};\n    rows.forEach(function (l) { (byStage[l.stage] = byStage[l.stage] || []).push(l); });\n    var cols = STAGES.concat(CLOSED).filter(function (s) {\n      return IDX[s.key] !== undefined || (byStage[s.key] && byStage[s.key].length);\n    });\n    return '<div class=\"ld-board\">' + cols.map(function (s) {\n      var list = byStage[s.key] || [];\n      return '<div class=\"ld-col\"><div class=\"ld-colh\"><span class=\"ld-colt\">' + esc(s.label) + '</span>' +\n        '<span class=\"ld-coln\">' + list.length + '</span></div>' +\n        (list.length ? list.map(cardHtml).join('') : '<div class=\"ld-empty\" style=\"padding:10px\">—</div>') + '</div>';\n    }).join('') + '</div>';\n  }\n\n  function listHtml() {\n    if (!rows.length) return '<div class=\"ld-empty\">' + (search ? 'Nothing matches “' + esc(search) + '”.' : view === 'archive' ? 'The archive is empty.' : 'No leads yet.') + '</div>';\n    return rows.map(function (l) {\n      var st = slaState(l);\n      return '<button class=\"ld-lrow\" onclick=\"ldOpen(' + l.id + ')\">' +\n        '<span class=\"ld-dot\" style=\"background:' + (st === 'late' ? '#DC2626' : st === 'soon' ? '#D97706' : 'var(--bdr)') + '\"></span>' +\n        '<span class=\"ld-lname\">' + esc(l.full_name || '(no name)') + '</span>' +\n        '<span class=\"ld-lsub\">' + esc([l.property_address, l.property_size].filter(Boolean).join(' · ') || l.email || '') + '</span>' +\n        '<span class=\"ld-stage\">' + esc(LABEL[l.stage] || l.stage) + '</span>' +\n        '<span class=\"ld-own\">' + esc(l.owner ? teamName(l.owner) : '—') + '</span>' +\n        '<span class=\"ld-lago\">' + ago(l.created_time || l.updated_at) + '</span>' +\n        '</button>';\n    }).join('');\n  }\n\n  window.renderLeads = function () {\n    var p = panel(); if (!p) return;\n    var late = rows.filter(function (l) { return slaState(l) === 'late'; }).length;\n    var unassigned = rows.filter(function (l) { return !l.owner && !l.archived_at; }).length;\n    var h = '<div class=\"ld-wrap\">' +\n      '<div class=\"ld-head\"><div class=\"ld-top\"><div>' +\n        '<div class=\"ld-brand\">🎯 Leads</div>' +\n        '<div class=\"ld-sub\">' + rows.length + (view === 'archive' ? ' archived' : ' active') +\n          (late ? ' · <b style=\"color:#DC2626\">' + late + ' past first-contact SLA</b>' : '') +\n          (unassigned ? ' · ' + unassigned + ' unassigned' : '') + '</div>' +\n        '</div>' +\n        '<span class=\"ld-meta ' + (metaOn ? 'on' : 'off') + '\" title=\"' + (metaOn ? 'Leads sync from Meta every 5 minutes' : 'Set META_PAGE_TOKEN to sync automatically') + '\">' +\n          (metaOn ? '● Meta connected' : '○ Meta not connected') + '</span>' +\n      '</div>' + loadStrip() + '</div>' +\n      '<div class=\"ld-controls\">' +\n        '<div class=\"ld-tabs\">' +\n          ['board', 'list', 'archive'].map(function (v) {\n            return '<button class=\"ldtab' + (view === v ? ' on' : '') + '\" onclick=\"ldView(\\'' + v + '\\')\">' +\n              (v === 'board' ? 'Board' : v === 'list' ? 'List' : 'Archive') + '</button>';\n          }).join('') +\n        '</div>' +\n        '<input class=\"ld-search\" id=\"ld-searchbox\" placeholder=\"Search name, phone, address, campaign…\" value=\"' + esc(search) + '\" oninput=\"ldSearch(this.value)\">' +\n        '<span class=\"ld-spacer\"></span>' +\n        (metaOn ? '<button class=\"btn sm\" onclick=\"ldPull()\">↻ Pull from Meta</button>' : '') +\n        '<button class=\"btn sm primary\" onclick=\"ldNew()\">+ New lead</button>' +\n      '</div>' +\n      (loadErr ? '<div class=\"ld-empty\" style=\"color:#DC2626\">Could not load leads: ' + esc(loadErr) + '</div>'\n       : loading ? '<div class=\"ld-empty\">Loading…</div>'\n       : view === 'board' ? boardHtml() : listHtml()) +\n      '</div>';\n    p.innerHTML = h + (sheet || '');\n  };\n\n  // Controls\n  function render() { window.renderLeads(); }\n  window.ldView = function (v) { view = v; openId = null; sheet = null; reload(); };\n  window.ldSearch = function (v) {\n    search = v;\n    clearTimeout(_searchT);\n    _searchT = setTimeout(function () {\n      reload().then(function () {\n        var el = document.getElementById('ld-searchbox');\n        if (el) { el.focus(); try { el.setSelectionRange(el.value.length, el.value.length); } catch (e) {} }\n      });\n    }, 260);\n  };\n  window.ldPull = function () {\n    toast('Asking Meta for new leads…');\n    jsend('/api/leads/meta/pull', 'POST', { trigger: 'manual' }).then(function (r) {\n      if (!r.ok) { toast((r.j && r.j.error) || 'Meta pull failed.', 'err'); return; }\n      var st = r.j.state || {};\n      toast('Meta: ' + (st.created || 0) + ' new, ' + (st.seen || 0) + ' seen across ' + (st.forms || 0) + ' form(s).');\n      reload();\n    });\n  };\n\n  // Ticket\n  function lead(id) { return rows.filter(function (l) { return l.id === id; })[0]; }\n\n  window.ldOpen = function (id, quiet) { if (openId !== id) editProp = false; openId = id; openTicket(id, quiet); };\n  window.ldClose = function () { openId = null; sheet = null; editProp = false; render(); };\n\n  function openTicket(id) {\n    var l = lead(id); if (!l) { sheet = null; render(); return; }\n    var f = l.fields && typeof l.fields === 'object' ? l.fields : {};\n    var props = [\n      ['Address', l.property_address], ['Size', l.property_size], ['Type', l.property_type],\n      ['Bedrooms', l.bedrooms], ['Bathrooms', l.bathrooms]\n    ].filter(function (p) { return p[1]; });\n    // Answers already promoted to columns are not repeated in the raw list.\n    var shown = {};\n    [l.property_address, l.property_size, l.property_type, l.bedrooms, l.bathrooms, l.full_name, l.email, l.phone]\n      .forEach(function (v) { if (v) shown[String(v)] = 1; });\n    var extra = Object.keys(f).filter(function (k) { return f[k] && !shown[String(f[k])]; });\n    var ev = Array.isArray(l.events) ? l.events.slice().reverse() : [];\n    var cur = IDX[l.stage];\n\n    sheet = '<div class=\"ld-sheetbg\" onclick=\"if(event.target===this)ldClose()\"><div class=\"ld-sheet\">' +\n      '<div class=\"ld-sh\"><div><div class=\"ld-sht\">' + esc(l.full_name || '(no name)') + '</div>' +\n        '<div class=\"ld-shs\">' + esc(LABEL[l.stage] || l.stage) + ' · ' + esc(l.owner ? teamName(l.owner) : 'unassigned') +\n          ' · ' + esc(l.source || 'meta') + (l.campaign ? ' · ' + esc(l.campaign) : '') +\n          ' · arrived ' + since(l.created_time || l.updated_at) + '</div></div>' +\n        '<button class=\"ld-x\" onclick=\"ldClose()\" title=\"Close\">×</button></div>' +\n      '<div class=\"ld-body\">' +\n\n      // contact — big tap targets, and real mailto:/tel: so a phone can act on them\n      '<div class=\"ld-contact\">' +\n        (l.email ? '<a class=\"ld-cbtn\" href=\"mailto:' + esc(l.email) + '\">✉ ' + esc(l.email) + '</a>' : '') +\n        (l.phone ? '<a class=\"ld-cbtn\" href=\"tel:' + esc(String(l.phone).replace(/[^0-9+]/g, '')) + '\">📞 ' + esc(l.phone) + '</a>' : '') +\n        (!l.email && !l.phone ? '<span style=\"font-size:12px;color:var(--tx3)\">No contact details on this lead.</span>' : '') +\n      '</div>' +\n\n      // Half the answers arrive as a range or a guess (\"50-100 τ.μ.\") and get\n      // pinned down on the call, so the block is editable rather than read-only.\n      '<div class=\"ld-sec\"><div class=\"ld-sect\">The property' +\n        (editProp ? '' : ' <button class=\"btn sm\" style=\"padding:1px 7px;font-size:10px;margin-left:6px\" onclick=\"ldEditProp(1)\">✎ Edit</button>') +\n      '</div>' +\n      (editProp\n        ? '<div class=\"ld-form\">' +\n            '<div class=\"full\"><div class=\"ld-sect\">Address</div><input class=\"ld-in\" id=\"ldp-addr\" value=\"' + esc(l.property_address || '') + '\"></div>' +\n            '<div><div class=\"ld-sect\">Size</div><input class=\"ld-in\" id=\"ldp-size\" value=\"' + esc(l.property_size || '') + '\"></div>' +\n            '<div><div class=\"ld-sect\">Type</div><input class=\"ld-in\" id=\"ldp-type\" value=\"' + esc(l.property_type || '') + '\"></div>' +\n            '<div><div class=\"ld-sect\">Bedrooms</div><input class=\"ld-in\" id=\"ldp-beds\" value=\"' + esc(l.bedrooms || '') + '\"></div>' +\n            '<div><div class=\"ld-sect\">Bathrooms</div><input class=\"ld-in\" id=\"ldp-baths\" value=\"' + esc(l.bathrooms || '') + '\"></div>' +\n            '<div class=\"full\" style=\"display:flex;gap:8px;justify-content:flex-end\">' +\n              '<button class=\"btn sm\" onclick=\"ldEditProp(0)\">Cancel</button>' +\n              '<button class=\"btn sm primary\" onclick=\"ldSaveProp(' + l.id + ')\">Save details</button></div>' +\n          '</div>'\n        : props.length\n          ? '<div class=\"ld-kv\">' + props.map(function (p) { return '<span class=\"ld-k\">' + esc(p[0]) + '</span><span class=\"ld-v\">' + esc(p[1]) + '</span>'; }).join('') + '</div>'\n          : '<div style=\"font-size:11.5px;color:var(--tx3)\">Nothing about the property yet — the form did not ask, or they did not say.</div>') +\n      '</div>' +\n\n      (extra.length ? '<div class=\"ld-sec\"><div class=\"ld-sect\">What they answered</div><div class=\"ld-kv\">' +\n        extra.map(function (k) { return '<span class=\"ld-k\">' + esc(k) + '</span><span class=\"ld-v\">' + esc(f[k]) + '</span>'; }).join('') +\n        '</div></div>' : '') +\n\n      '<div class=\"ld-sec\"><div class=\"ld-sect\">Stage</div><div class=\"ld-steps\">' +\n        STAGES.map(function (s, i) {\n          var cls = 'ldpill' + (cur !== undefined && i < cur ? ' done' : '') + (s.key === l.stage ? ' cur' : '');\n          return '<button class=\"' + cls + '\" title=\"' + esc(s.hint) + '\" onclick=\"ldStage(' + l.id + ',\\'' + s.key + '\\')\">' + esc(s.label) + '</button>';\n        }).join('') +\n        CLOSED.map(function (s) {\n          return '<button class=\"ldpill' + (s.key === l.stage ? ' cur' : '') + '\" title=\"' + esc(s.hint) + '\" onclick=\"ldStage(' + l.id + ',\\'' + s.key + '\\')\">' + esc(s.label) + '</button>';\n        }).join('') +\n      '</div>' +\n      (l.lost_reason ? '<div style=\"font-size:11.5px;color:#DC2626;margin-top:8px\">Lost: ' + esc(l.lost_reason) + '</div>' : '') +\n      '</div>' +\n\n      '<div class=\"ld-sec\"><div class=\"ld-sect\">Assigned to</div>' +\n        '<select class=\"ld-in\" onchange=\"ldOwner(' + l.id + ',this.value)\">' +\n          '<option value=\"\"' + (!l.owner ? ' selected' : '') + '>— nobody —</option>' +\n          (cfg.team || []).map(function (t) {\n            return '<option value=\"' + esc(t.key) + '\"' + (l.owner === t.key ? ' selected' : '') + '>' + esc(t.name) + '</option>';\n          }).join('') +\n        '</select></div>' +\n\n      '<div class=\"ld-sec\"><div class=\"ld-sect\">Add a note</div>' +\n        '<input class=\"ld-in\" id=\"ld-note\" placeholder=\"What happened — goes on the timeline\" ' +\n          'onkeydown=\"if(event.key===\\'Enter\\')ldNote(' + l.id + ')\">' +\n        '<button class=\"btn sm\" style=\"margin-top:7px\" onclick=\"ldNote(' + l.id + ')\">Add note</button></div>' +\n\n      '<div class=\"ld-sec\"><div class=\"ld-sect\">Timeline</div><div class=\"ld-tl\">' +\n        (ev.length ? ev.map(function (e) {\n          return '<div class=\"ld-ev\"><span class=\"ld-evw\">' + esc(when(e.at)) + '</span>' +\n            '<span><b>' + esc(e.by || '') + '</b> ' + esc(EVW[e.type] || e.type || '') + ' ' + esc(evDetail(e)) + '</span></div>';\n        }).join('') : '<div style=\"font-size:11.5px;color:var(--tx3)\">Nothing yet.</div>') +\n      '</div></div>' +\n\n      '<div class=\"ld-danger\">' +\n        (l.archived_at\n          ? '<button class=\"btn sm\" onclick=\"ldArchive(' + l.id + ',1)\">↩ Restore from archive</button>'\n          : '<button class=\"btn sm\" onclick=\"ldArchive(' + l.id + ',0)\">🗄 Archive</button>') +\n        '<button class=\"btn sm danger\" onclick=\"ldErase(' + l.id + ')\">🗑 Delete permanently</button>' +\n        '<span class=\"ld-spacer\"></span>' +\n        '<span style=\"font-size:10.5px;color:var(--tx3);align-self:center\">Lead #' + l.id +\n          (l.meta_lead_id ? ' · Meta ' + esc(l.meta_lead_id) : '') + '</span>' +\n      '</div>' +\n\n      '</div></div></div>';\n    render();\n  }\n\n  // Actions\n  function after(r, msg) {\n    if (!r.ok) { toast((r.j && r.j.error) || 'That did not save.', 'err'); return false; }\n    if (msg) toast(msg);\n    reload(true);\n    return true;\n  }\n  window.ldStage = function (id, stage) {\n    var l = lead(id); if (!l || l.stage === stage) return;\n    var body = { stage: stage, by: who() };\n    if (stage === 'lost') {\n      var why = prompt('Why was this lead lost?');\n      if (why === null) return;\n      if (!String(why).trim()) { toast('A lost lead needs a reason.', 'err'); return; }\n      body.lostReason = String(why).trim();\n    }\n    jsend('/api/leads/' + id, 'PATCH', body).then(function (r) { after(r, 'Moved to ' + (LABEL[stage] || stage) + '.'); });\n  };\n  window.ldOwner = function (id, owner) {\n    jsend('/api/leads/' + id, 'PATCH', { owner: owner || null, by: who() })\n      .then(function (r) { after(r, owner ? 'Reassigned to ' + teamName(owner) + '.' : 'Unassigned.'); });\n  };\n  window.ldNote = function (id) {\n    var el = document.getElementById('ld-note'); if (!el) return;\n    var v = String(el.value || '').trim(); if (!v) return;\n    jsend('/api/leads/' + id, 'PATCH', { note: v, by: who() }).then(function (r) { after(r, 'Note added.'); });\n  };\n  window.ldEditProp = function (on) { editProp = !!on; if (openId) openTicket(openId); };\n  window.ldSaveProp = function (id) {\n    var g = function (k) { var e = document.getElementById(k); return e ? String(e.value || '').trim() : ''; };\n    jsend('/api/leads/' + id, 'PATCH', {\n      propertyAddress: g('ldp-addr'), propertySize: g('ldp-size'), propertyType: g('ldp-type'),\n      bedrooms: g('ldp-beds'), bathrooms: g('ldp-baths'), by: who()\n    }).then(function (r) { editProp = false; after(r, 'Property details saved.'); });\n  };\n  window.ldArchive = function (id, restore) {\n    var l = lead(id);\n    var reason = '';\n    if (!restore) {\n      reason = prompt('Archive \"' + ((l && l.full_name) || 'this lead') + '\"?\\n\\nWhy — spam, duplicate, test, not interested…');\n      if (reason === null) return;\n    }\n    jsend('/api/leads/' + id + '/archive', 'POST', { restore: !!restore, reason: reason, by: who() }).then(function (r) {\n      if (!r.ok) { toast((r.j && r.j.error) || 'That did not save.', 'err'); return; }\n      openId = null; sheet = null;\n      if (restore) { toast('Restored.'); reload(); return; }\n      // Archiving is reversible and should feel it — undo without hunting for it.\n      toast('Archived. <a href=\"#\" onclick=\"ldArchive(' + id + ',1);return false\" style=\"color:#C9A84C;font-weight:600\">Undo</a>');\n      reload();\n    });\n  };\n  // Permanent erase is the GDPR route, not the tidy-up button — hence the\n  // password and the typed confirmation naming the lead.\n  window.ldErase = function (id) {\n    var l = lead(id); if (!l) return;\n    var name = l.full_name || 'this lead';\n    if (!confirm('Permanently erase \"' + name + '\"?\\n\\nName, email, phone, the Meta payload and the property details are wiped. ' +\n                 'A tombstone row stays so the funnel counts and the erasure itself remain provable.\\n\\nThis cannot be undone.')) return;\n    var pw = prompt('Enter the password to confirm the erasure:');\n    if (pw === null) return;\n    jsend('/api/leads/' + id, 'DELETE', { password: String(pw).trim(), by: who() }).then(function (r) {\n      if (!r.ok) { toast((r.j && r.j.error) || 'Not erased.', 'err'); return; }\n      openId = null; sheet = null; toast('Erased. The tombstone stays.'); reload();\n    });\n  };\n\n  // New lead\n  window.ldNew = function () {\n    sheet = '<div class=\"ld-sheetbg\" onclick=\"if(event.target===this)ldClose()\"><div class=\"ld-sheet\">' +\n      '<div class=\"ld-sh\"><div><div class=\"ld-sht\">New lead</div>' +\n        '<div class=\"ld-shs\">Phone, referral, walk-in — anything that did not come through Meta</div></div>' +\n        '<button class=\"ld-x\" onclick=\"ldClose()\">×</button></div>' +\n      '<div class=\"ld-body\"><div class=\"ld-form\">' +\n        '<div class=\"full\"><div class=\"ld-sect\">Name *</div><input class=\"ld-in\" id=\"ldn-name\" placeholder=\"Who got in touch\"></div>' +\n        '<div><div class=\"ld-sect\">Email</div><input class=\"ld-in\" id=\"ldn-email\" type=\"email\" placeholder=\"name@example.com\"></div>' +\n        '<div><div class=\"ld-sect\">Phone</div><input class=\"ld-in\" id=\"ldn-phone\" type=\"tel\" placeholder=\"69…\"></div>' +\n        '<div class=\"full\"><div class=\"ld-sect\">Property address</div><input class=\"ld-in\" id=\"ldn-addr\" placeholder=\"Area and street\"></div>' +\n        '<div><div class=\"ld-sect\">Size</div><input class=\"ld-in\" id=\"ldn-size\" placeholder=\"e.g. 85 τ.μ.\"></div>' +\n        '<div><div class=\"ld-sect\">How it came in</div><select class=\"ld-in\" id=\"ldn-src\">' +\n          '<option value=\"phone\">Phone</option><option value=\"referral\">Referral</option>' +\n          '<option value=\"walk-in\">Walk-in</option><option value=\"manual\">Other</option></select></div>' +\n        '<div><div class=\"ld-sect\">Bedrooms</div><input class=\"ld-in\" id=\"ldn-beds\" placeholder=\"e.g. 2\"></div>' +\n        '<div><div class=\"ld-sect\">Bathrooms</div><input class=\"ld-in\" id=\"ldn-baths\" placeholder=\"e.g. 1\"></div>' +\n        '<div class=\"full\"><div class=\"ld-sect\">Note</div><input class=\"ld-in\" id=\"ldn-note\" placeholder=\"Anything worth remembering\"></div>' +\n        '<div class=\"full\" style=\"display:flex;gap:8px;justify-content:flex-end;margin-top:4px\">' +\n          '<button class=\"btn sm\" onclick=\"ldClose()\">Cancel</button>' +\n          '<button class=\"btn sm primary\" onclick=\"ldCreate(0)\">Create lead</button></div>' +\n      '</div></div></div></div>';\n    render();\n    var el = document.getElementById('ldn-name'); if (el) el.focus();\n  };\n  window.ldCreate = function (force) {\n    var g = function (id) { var e = document.getElementById(id); return e ? String(e.value || '').trim() : ''; };\n    var body = {\n      fullName: g('ldn-name'), email: g('ldn-email'), phone: g('ldn-phone'),\n      source: g('ldn-src') || 'manual', propertyAddress: g('ldn-addr'), propertySize: g('ldn-size'),\n      bedrooms: g('ldn-beds'), bathrooms: g('ldn-baths'), note: g('ldn-note'), by: who(), force: !!force\n    };\n    if (!body.fullName) { toast('A name is required.', 'err'); return; }\n    if (!body.email && !body.phone) { toast('An email or a phone number is required.', 'err'); return; }\n    jsend('/api/leads', 'POST', body).then(function (r) {\n      if (r.status === 409 && r.j && r.j.duplicate) {\n        var d = r.j.duplicate;\n        // Monday's Meta form and Wednesday's phone call must not become two\n        // tickets fighting for two owners.\n        if (confirm((d.full_name || 'Someone') + ' is already an open lead (' + (LABEL[d.stage] || d.stage) +\n                    ', ' + (d.owner ? teamName(d.owner) : 'unassigned') + ').\\n\\nOK to open that one, Cancel to add a second anyway.')) {\n          sheet = null; reload().then(function () { window.ldOpen(d.id); });\n        } else { window.ldCreate(1); }\n        return;\n      }\n      if (!r.ok) { toast((r.j && r.j.error) || 'Not created.', 'err'); return; }\n      sheet = null; openId = r.j.id || null;\n      toast('Lead created' + (r.j.owner ? ' and assigned to ' + teamName(r.j.owner) : '') + '.');\n      reload().then(function () { if (openId) window.ldOpen(openId); });\n    });\n  };\n\n  // Wiring\n  // The tab strip scrolls sideways now, so whichever tab you just opened has to\n  // be brought into view — otherwise you can click a tab and see no underline.\n  // 'nearest' on both axes stops it scrolling the page itself.\n  function keepInView(name) {\n    try {\n      var b = document.querySelector('.nav-btn[data-tab=\"' + name + '\"]');\n      if (b && b.scrollIntoView) b.scrollIntoView({ block: 'nearest', inline: 'nearest' });\n    } catch (e) {}\n  }\n  var _prevShowTabLeads = window.showTab;\n  window.showTab = function (name, btn) {\n    if (name === 'leads') {\n      document.querySelectorAll('.tab-panel').forEach(function (p) { p.classList.remove('active'); });\n      document.querySelectorAll('.nav-btn').forEach(function (b) { b.classList.remove('active'); });\n      document.getElementById('tab-leads').classList.add('active');\n      if (btn) btn.classList.add('active');\n      openId = null; sheet = null; editProp = false;\n      keepInView(name);\n      reload();\n      return;\n    }\n    var r = _prevShowTabLeads.apply(this, arguments);\n    keepInView(name);\n    return r;\n  };\n})();\n</script>\n</body>\n</html>",
